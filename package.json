{
  "name": "ecuador-indicators-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first desktop explorer for Ecuadorian economic and social indicators",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --mode tauri-dev",
    "build": "node scripts/clean-fixture.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "verify:fast": "npm run lint && npm run typecheck && npm run test",
    "build:e2e": "node scripts/prepare-web-fixture.mjs mini && vite build --mode e2e",
    "check:bindings": "cargo test -p indicators-core export_bindings && git diff --exit-code -- src/adapters/tauri/generated",
    "fixtures:mini": "node scripts/prepare-web-fixture.mjs mini",
    "fonts:sync": "node scripts/sync-fonts.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.1",
    "@tauri-apps/api": "^2.12.5",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "fast-check": "^4.10.3",
    "jsdom": "^31.0.1",
    "papaparse": "^5.7.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
