{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ecuador Indicators",
  "version": "0.1.0",
  "identifier": "io.github.eduardo12pacheco.ecuadorindicators",
  "build": {
    "devUrl": "http://localhost:18080",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ecuador Indicators",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
